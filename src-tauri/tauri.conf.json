{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Docs Reader",
  "version": "3.1.0",
  "identifier": "com.garrymarkus.docsreader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Docs Reader",
        "width": 1024,
        "height": 768,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Garry Markus",
    "copyright": "Copyright © 2026 Garry Markus. All rights reserved.",
    "shortDescription": "Fast, Offline Multi-Format Document Reader for Windows",
    "longDescription": "Docs Reader is a fast, offline document reader for Windows supporting PDF, DOCX, XLSX, and PPTX with smooth 60-120 fps scrolling.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "Portable Document Format",
        "role": "Viewer"
      },
      {
        "ext": ["docx", "doc"],
        "name": "Word Document",
        "description": "Microsoft Word Document",
        "role": "Viewer"
      },
      {
        "ext": ["xlsx", "xls", "csv"],
        "name": "Excel Spreadsheet",
        "description": "Microsoft Excel Workbook",
        "role": "Viewer"
      },
      {
        "ext": ["pptx", "ppt"],
        "name": "PowerPoint Presentation",
        "description": "Microsoft PowerPoint Presentation",
        "role": "Viewer"
      }
    ]
  }
}
